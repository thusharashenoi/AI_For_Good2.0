# ─── RaktSetu Autonomous Engagement System ───────────────────────────────
# Copy to .env for local dev. In production ALL of these are read from
# AWS Secrets Manager (secret id: raktsetu/config) — never hardcode keys.

# --- Twilio ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+919076150904
TWILIO_VOICE_NUMBER=+91XXXXXXXXXX
# Approved WhatsApp content template SID for "donation_request_v1"
TWILIO_TEMPLATE_SID_DONATION_REQUEST=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Amazon Bedrock (the conversational agent brain) ---
# Model used by the strict Converse tool-use loop (shared/agent.py).
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# 1 = let the Bedrock agent drive turns even while LOCAL_MODE=1 (FSM fallback on error).
AGENT_FORCE_BEDROCK=1
# (optional) legacy Bedrock Agent ids if you provision a managed Agent instead.
BEDROCK_AGENT_ID=
BEDROCK_AGENT_ALIAS_ID=

# --- WhatsApp provider: "periskope" (proxy on your own number) or "twilio" ---
WA_PROVIDER=periskope
PERISKOPE_PHONE=919076150904
PERISKOPE_API_KEY=your_periskope_jwt_here

# --- Voice provider: "vapi" (AI voice) or "twilio" ---
VOICE_PROVIDER=vapi
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
# Public base URL (ngrok) for /vapi/tools — required during live calls
VAPI_SERVER_URL=https://your-subdomain.ngrok-free.app
VAPI_LIVE_CALLS=1
# Voice LLM — google + gemini-2.5-flash (needs Google key in Vapi Integrations)
VAPI_MODEL_PROVIDER=google
VAPI_MODEL=gemini-2.5-flash
VAPI_MODEL_MAX_TOKENS=180
VAPI_VOICE_PROVIDER=azure
VAPI_VOICE_ID=en-IN-NeerjaNeural
VAPI_WAIT_SECONDS=0.1
VAPI_ON_NO_PUNCTUATION_SECONDS=0.35
VAPI_TRANSCRIBER_PROVIDER=deepgram
VAPI_TRANSCRIBER_MODEL=nova-3
VAPI_TRANSCRIBER_LANGUAGE=multi

# --- DynamoDB tables (suffix -dev for AWS dev stack, -prod for production) ---
DYNAMODB_TABLE_CONVERSATIONS=raktsetu-conversations-dev
DYNAMODB_TABLE_DONORS=raktsetu-donors-dev
DYNAMODB_TABLE_PATIENTS=raktsetu-patients-dev
DYNAMODB_TABLE_REQUESTS=raktsetu-bloodRequests-dev
DYNAMODB_TABLE_APPOINTMENTS=raktsetu-appointments-dev
DYNAMODB_TABLE_WAITLIST=raktsetu-waitlist-dev
DYNAMODB_TABLE_PROCESSED_MESSAGES=raktsetu-processedMessages-dev

# --- AWS ---
AWS_REGION=ap-south-1
SECRETS_MANAGER_SECRET_ID=raktsetu/config

# --- Step Functions / EventBridge ---
OUTREACH_STATE_MACHINE_ARN=arn:aws:states:ap-south-1:000000000000:stateMachine:raktsetu-outreach
# Seconds to wait after WhatsApp outreach before placing a voice call (no reply)
OUTREACH_VOICE_ESCALATION_SECONDS=15
SCHEDULER_GROUP_NAME=raktsetu
SCHEDULER_ROLE_ARN=arn:aws:iam::000000000000:role/raktsetu-scheduler-role

# --- Geocoding ---
NOMINATIM_USER_AGENT=raktsetu-bloodwarriors
DEFAULT_CITY=Hyderabad

# --- Local dev toggles ---
# When LOCAL_MODE=1 the clients use an in-memory store / stubbed Twilio so you
# can run scripts/test_whatsapp_flow.py with no AWS or Twilio credentials.
LOCAL_MODE=0
EMERGENCY_HELPLINE=+91 62814 77836
