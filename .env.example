# Copy to .env and fill in. Never commit the real .env.

# AWS console (human login)
URL="https://<ACCOUNT_ID>.signin.aws.amazon.com/console"
ACCOUNT_ID="<aws-account-id>"
USERNAME="<iam-username>"
CONSOLE_PASSWORD="<console-password>"

# AWS programmatic access (boto3 / CLI) - create under Security credentials -> Access keys
AWS_ACCESS_KEY_ID="<access-key-id>"
AWS_SECRET_ACCESS_KEY="<secret-access-key>"
AWS_DEFAULT_REGION="us-east-1"

# Bedrock model ids (use cross-region inference-profile ids with the us. prefix)
BEDROCK_MODEL_ID="us.anthropic.claude-haiku-4-5-20251001-v1:0"
BEDROCK_FALLBACK_MODEL_ID="us.anthropic.claude-sonnet-4-6"
BEDROCK_CHEAP_MODEL_ID="us.amazon.nova-lite-v1:0"
